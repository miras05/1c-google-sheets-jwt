// ============================================================================
// Обмен JWT на access_token и запись в Google Sheets из 1С.
//
// Дополняет JWT_BignumRSA.bsl: там считается подпись, здесь — вся сетевая
// часть. Оба файла живут в одном модуле.
//
// ВАЖНО ПРО ПРОИЗВОДИТЕЛЬНОСТЬ: подпись JWT медленная (минуты), поэтому
// ПодписыватьНАДО ОДИН РАЗ за сеанс выгрузки. Полученный access_token живёт
// час — его достаточно на любое количество запросов к таблице. Никогда не
// вызывайте ПостроитьJWT в цикле по строкам.
//
// Разбор JSON здесь сделан вручную на строковых операциях, а не через
// ЧтениеJSON. Причина прагматичная: нам нужно вытащить ровно одно поле
// (access_token) из короткого предсказуемого ответа Google, и не хочется
// зависеть от ещё одного платформенного объекта — в этой инсталляции 1С уже
// не нашлось нескольких «стандартных» функций.
// ============================================================================


// Достаёт строковое значение поля из плоского JSON вида {"ключ": "значение"}.
// Возвращает пустую строку, если поля нет.
Функция ЗначениеИзJSON(Знач ТекстJSON, Знач ИмяПоля) Экспорт
	Шаблон = """" + ИмяПоля + """";
	Позиция = СтрНайти(ТекстJSON, Шаблон);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	// после имени поля идёт двоеточие, пробелы, затем значение в кавычках
	Индекс = Позиция + СтрДлина(Шаблон);
	Длина = СтрДлина(ТекстJSON);

	// пропускаем пробелы и двоеточие
	Пока Индекс <= Длина Цикл
		Симв = Сред(ТекстJSON, Индекс, 1);
		Если Симв = ":" Или Симв = " " Тогда
			Индекс = Индекс + 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Индекс > Длина Тогда
		Возврат "";
	КонецЕсли;

	// значение должно начинаться с кавычки
	Если Сред(ТекстJSON, Индекс, 1) <> """" Тогда
		Возврат "";
	КонецЕсли;
	Индекс = Индекс + 1;

	Результат = "";
	Пока Индекс <= Длина Цикл
		Симв = Сред(ТекстJSON, Индекс, 1);
		Если Симв = """" Тогда
			Прервать;
		КонецЕсли;
		Результат = Результат + Симв;
		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат Результат;
КонецФункции


// Меняет подписанный JWT на access_token у Google.
// Возвращает структуру: Успех (Булево), Токен (Строка), Ошибка (Строка).
Функция ПолучитьAccessToken(Знач JWT) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Токен", "");
	Результат.Вставить("Ошибка", "");

	Попытка
		Защита = Новый ЗащищенноеСоединениеOpenSSL();
		Соединение = Новый HTTPСоединение("oauth2.googleapis.com", 443, , , , 60, Защита);

		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded");

		Запрос = Новый HTTPЗапрос("/token", Заголовки);
		Тело = "grant_type=urn%3Aietf%3Aparams%3Aoauth%3Agrant-type%3Ajwt-bearer&assertion=" + JWT;
		Запрос.УстановитьТелоИзСтроки(Тело);

		Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
		ТекстОтвета = Ответ.ПолучитьТелоКакСтроку();

		Если Ответ.КодСостояния <> 200 Тогда
			Результат.Ошибка = "Google вернул код " + ЧислоВСтроку(Ответ.КодСостояния) + ": " + ТекстОтвета;
			Возврат Результат;
		КонецЕсли;

		Токен = ЗначениеИзJSON(ТекстОтвета, "access_token");
		Если СтрДлина(Токен) = 0 Тогда
			Результат.Ошибка = "В ответе Google нет access_token. Ответ: " + ТекстОтвета;
			Возврат Результат;
		КонецЕсли;

		Результат.Успех = Истина;
		Результат.Токен = Токен;

	Исключение
		Результат.Ошибка = "Сбой соединения с Google: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;
КонецФункции


// Экранирование строки для JSON: кавычки, обратные слэши, переводы строк.
// Без этого любое название номенклатуры с кавычкой сломает весь запрос.
Функция ЭкранироватьJSON(Знач Текст) Экспорт
	Результат = "";
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Симв = Сред(Текст, Индекс, 1);
		Если Симв = """" Тогда
			Результат = Результат + "\""";
		ИначеЕсли Симв = "\" Тогда
			Результат = Результат + "\\";
		ИначеЕсли Симв = Символы.ПС Тогда
			Результат = Результат + "\n";
		ИначеЕсли Симв = Символы.ВК Тогда
			Результат = Результат + "\r";
		ИначеЕсли Симв = Символы.Таб Тогда
			Результат = Результат + "\t";
		Иначе
			Результат = Результат + Симв;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции


// Число с дробной частью в строку, разделитель — точка, без разделителей
// разрядов. Нужна для сумм: штатное Строка(1234.5) вернуло бы «1 234,5» —
// с пробелами и запятой, что для Google Sheets мусор (он не распознает это
// как число, и в таблице получится текст, который не суммируется).
Функция ЧислоВСтрокуДесятичное(Знач Ч, Знач ЗнаковПослеЗапятой = 2) Экспорт
	Если Ч < 0 Тогда
		Знак = "-";
		Ч = -Ч;
	Иначе
		Знак = "";
	КонецЕсли;

	ЦелаяЧасть = Цел(Ч);

	Множитель = 1;
	Для Индекс = 1 По ЗнаковПослеЗапятой Цикл
		Множитель = Множитель * 10;
	КонецЦикла;

	// Округление к ближайшему: прибавляем половину младшего разряда.
	Дробная = Цел((Ч - ЦелаяЧасть) * Множитель + 0.5);
	Если Дробная >= Множитель Тогда
		ЦелаяЧасть = ЦелаяЧасть + 1;
		Дробная = 0;
	КонецЕсли;

	Результат = Знак + ЧислоВСтроку(ЦелаяЧасть);

	Если ЗнаковПослеЗапятой > 0 Тогда
		ТекстДробной = ЧислоВСтроку(Дробная);
		Пока СтрДлина(ТекстДробной) < ЗнаковПослеЗапятой Цикл
			ТекстДробной = "0" + ТекстДробной;
		КонецЦикла;
		Результат = Результат + "." + ТекстДробной;
	КонецЕсли;

	Возврат Результат;
КонецФункции

// Значение любого типа в строку, пригодную для JSON.
// Отдельная функция, потому что штатное Строка() форматирует числа и даты
// по региональным настройкам — с пробелами и запятыми, что ломает и JSON,
// и распознавание чисел в самой таблице.
Функция ЗначениеВСтроку(Знач ЗначениеЯчейки) Экспорт
	Тип_ = ТипЗнч(ЗначениеЯчейки);

	Если Тип_ = Тип("Строка") Тогда
		Возврат ЗначениеЯчейки;

	ИначеЕсли Тип_ = Тип("Число") Тогда
		Если ЗначениеЯчейки = Цел(ЗначениеЯчейки) Тогда
			Если ЗначениеЯчейки < 0 Тогда
				Возврат "-" + ЧислоВСтроку(-ЗначениеЯчейки);
			Иначе
				Возврат ЧислоВСтроку(ЗначениеЯчейки);
			КонецЕсли;
		Иначе
			Возврат ЧислоВСтрокуДесятичное(ЗначениеЯчейки, 2);
		КонецЕсли;

	ИначеЕсли Тип_ = Тип("Дата") Тогда
		// ГГГГ-ММ-ДД — формат, который Google Sheets понимает как дату
		// независимо от локали таблицы.
		// Переменные намеренно названы не так, как функции Год()/Месяц()/День():
		// «Год = Год(Дата)» затеняет встроенную функцию собственной переменной —
		// в 1С это сработает, но при любой правке ниже по коду сломается молча.
		ГодЗнач = Год(ЗначениеЯчейки);
		МесяцЗнач = Месяц(ЗначениеЯчейки);
		ДеньЗнач = День(ЗначениеЯчейки);
		ТекстМесяца = ЧислоВСтроку(МесяцЗнач);
		Если СтрДлина(ТекстМесяца) < 2 Тогда
			ТекстМесяца = "0" + ТекстМесяца;
		КонецЕсли;
		ТекстДня = ЧислоВСтроку(ДеньЗнач);
		Если СтрДлина(ТекстДня) < 2 Тогда
			ТекстДня = "0" + ТекстДня;
		КонецЕсли;
		Возврат ЧислоВСтроку(ГодЗнач) + "-" + ТекстМесяца + "-" + ТекстДня;

	ИначеЕсли Тип_ = Тип("Булево") Тогда
		Если ЗначениеЯчейки Тогда
			Возврат "да";
		Иначе
			Возврат "нет";
		КонецЕсли;

	Иначе
		// Ссылки на справочники и прочее — через штатное представление.
		Возврат Строка(ЗначениеЯчейки);
	КонецЕсли;
КонецФункции

// Готовый фрагмент JSON для одной ячейки — СО СКОБКАМИ или БЕЗ, по типу.
//
// Ключевой момент, выясненный живым тестом: числа надо отправлять как
// настоящие JSON-числа (без кавычек). Если слать строкой «"15000.50"», Google
// пытается распознать её по локали таблицы — а в русской локали десятичный
// разделитель запятая, поэтому «15000.50» попадает в ячейку ТЕКСТОМ,
// прижатым влево, и не суммируется формулами. Число без кавычек принимается
// как число при любой локали.
Функция ЗначениеВJSON(Знач ЗначениеЯчейки) Экспорт
	Тип_ = ТипЗнч(ЗначениеЯчейки);

	Если Тип_ = Тип("Число") Тогда
		Если ЗначениеЯчейки = Цел(ЗначениеЯчейки) Тогда
			Если ЗначениеЯчейки < 0 Тогда
				Возврат "-" + ЧислоВСтроку(-ЗначениеЯчейки);
			Иначе
				Возврат ЧислоВСтроку(ЗначениеЯчейки);
			КонецЕсли;
		Иначе
			Возврат ЧислоВСтрокуДесятичное(ЗначениеЯчейки, 2);
		КонецЕсли;
	Иначе
		Возврат """" + ЭкранироватьJSON(ЗначениеВСтроку(ЗначениеЯчейки)) + """";
	КонецЕсли;
КонецФункции

// Собирает JSON-тело для Sheets API из таблицы значений.
// Строки — Массив, каждый элемент — Массив значений (одна строка листа).
// Числа уходят числами, остальное — строками (см. ЗначениеВJSON).
Функция СобратьТелоValues(Знач Строки) Экспорт
	Тело = "{""values"":[";
	Для НомерСтроки = 0 По Строки.Количество() - 1 Цикл
		Если НомерСтроки > 0 Тогда
			Тело = Тело + ",";
		КонецЕсли;
		Тело = Тело + "[";
		Ячейки = Строки[НомерСтроки];
		Для НомерЯчейки = 0 По Ячейки.Количество() - 1 Цикл
			Если НомерЯчейки > 0 Тогда
				Тело = Тело + ",";
			КонецЕсли;
			Тело = Тело + ЗначениеВJSON(Ячейки[НомерЯчейки]);
		КонецЦикла;
		Тело = Тело + "]";
	КонецЦикла;
	Тело = Тело + "]}";
	Возврат Тело;
КонецФункции


// Дописывает строки в конец листа (append).
// Диапазон — например "Лист1!A1" (Google сам найдёт конец таблицы).
// Возвращает структуру: Успех, Ошибка.
Функция ДописатьСтроки(Знач Токен, Знач IDТаблицы, Знач Диапазон, Знач Строки) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Ошибка", "");

	Попытка
		Защита = Новый ЗащищенноеСоединениеOpenSSL();
		Соединение = Новый HTTPСоединение("sheets.googleapis.com", 443, , , , 60, Защита);

		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
		Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

		Адрес = "/v4/spreadsheets/" + IDТаблицы + "/values/" + Диапазон
			+ ":append?valueInputOption=USER_ENTERED&insertDataOption=INSERT_ROWS";

		Запрос = Новый HTTPЗапрос(Адрес, Заголовки);
		Запрос.УстановитьТелоИзСтроки(СобратьТелоValues(Строки), КодировкаТекста.UTF8);

		Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);

		Если Ответ.КодСостояния <> 200 Тогда
			Результат.Ошибка = "Sheets API вернул код " + ЧислоВСтроку(Ответ.КодСостояния)
				+ ": " + Ответ.ПолучитьТелоКакСтроку();
			Возврат Результат;
		КонецЕсли;

		Результат.Успех = Истина;

	Исключение
		Результат.Ошибка = "Сбой записи в таблицу: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;
КонецФункции


// ============================================================================
// СКВОЗНОЙ ТЕСТ: подпись -> токен -> запись строки в таблицу.
// Это то, ради чего всё затевалось. Занимает минуты (из-за подписи).
// ============================================================================

Процедура СамотестЗаписиВТаблицу(Знач ClientEmail, Знач PrivateKeyPEM, Знач IDТаблицы, Знач Лист) Экспорт
	Сообщить("1/3 Подписываю JWT (медленно, ждите)...");
	ВремяСтарта = ТекущаяДата();

	ВремяUnix = (ТекущаяУниверсальнаяДата() - Дата(1970, 1, 1));
	JWT = ПостроитьJWT(ClientEmail, PrivateKeyPEM, "https://www.googleapis.com/auth/spreadsheets", ВремяUnix);

	Сообщить("    подпись заняла " + ЧислоВСтроку(ТекущаяДата() - ВремяСтарта) + " сек");

	Сообщить("2/3 Меняю JWT на access_token...");
	ОтветТокена = ПолучитьAccessToken(JWT);
	Если Не ОтветТокена.Успех Тогда
		Сообщить("    ОШИБКА: " + ОтветТокена.Ошибка);
		Возврат;
	КонецЕсли;
	Сообщить("    токен получен, длина " + ЧислоВСтроку(СтрДлина(ОтветТокена.Токен)));

	Сообщить("3/3 Пишу тестовую строку в таблицу...");
	Строка1 = Новый Массив;
	Строка1.Добавить("тест из 1С");
	Строка1.Добавить(ЧислоВСтроку(ВремяUnix));
	Строка1.Добавить("можно удалить");

	Строки = Новый Массив;
	Строки.Добавить(Строка1);

	ОтветЗаписи = ДописатьСтроки(ОтветТокена.Токен, IDТаблицы, Лист + "!A1", Строки);
	Если ОтветЗаписи.Успех Тогда
		Сообщить("    ГОТОВО — строка записана в таблицу. Проверьте лист «" + Лист + "».");
	Иначе
		Сообщить("    ОШИБКА: " + ОтветЗаписи.Ошибка);
	КонецЕсли;
КонецПроцедуры


// Очищает лист целиком (POST values/{Лист}:clear). Удобно для полной
// перезаписи: очистить -> записать заново, без риска дублей.
Функция ОчиститьЛист(Знач Токен, Знач IDТаблицы, Знач Лист) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Ошибка", "");

	Попытка
		Защита = Новый ЗащищенноеСоединениеOpenSSL();
		Соединение = Новый HTTPСоединение("sheets.googleapis.com", 443, , , , 60, Защита);

		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Authorization", "Bearer " + Токен);
		Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

		Запрос = Новый HTTPЗапрос("/v4/spreadsheets/" + IDТаблицы + "/values/" + Лист + ":clear", Заголовки);
		Запрос.УстановитьТелоИзСтроки("{}", КодировкаТекста.UTF8);

		Ответ = Соединение.ВызватьHTTPМетод("POST", Запрос);
		Если Ответ.КодСостояния <> 200 Тогда
			Результат.Ошибка = "Sheets API (очистка) вернул код " + ЧислоВСтроку(Ответ.КодСостояния)
				+ ": " + Ответ.ПолучитьТелоКакСтроку();
			Возврат Результат;
		КонецЕсли;

		Результат.Успех = Истина;
	Исключение
		Результат.Ошибка = "Сбой очистки листа: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;
КонецФункции
