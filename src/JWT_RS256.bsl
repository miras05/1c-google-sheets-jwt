// ============================================================================
// Подпись JWT (RS256) для Google Service Account БЕЗ внешних процессов.
//
// Зачем: openssl.exe заблокирован на сервере заказчика (ЗапуститьПриложение
// не работает). Этот модуль реализует RSA-подпись на больших числах и SHA-256
// целиком на чистом BSL — не вызывает ничего вне 1С, поэтому никакая
// блокировка внешних процессов на него не действует в принципе.
//
// Плата за это — скорость: подпись занимает минуты на интерпретируемом BSL
// (арифметика на числах в тысячи бит не бывает быстрой без аппаратной
// поддержки). Для регламентного задания, которое запускается раз в сутки
// ночью, это не проблема — просто закладывайте это время в расписание.
//
// СНАЧАЛА ЗАПУСТИТЕ ТЕСТЫ (процедуры в самом низу файла) — они проверяют
// SHA-256 и Base64 на известных эталонных значениях за секунды, независимо
// от медленной RSA-части. Если тесты прошли — база (хэш, кодирование)
// точно верна, и искать баги, если что-то не так, нужно уже только в
// RSA/DER-части.
// ============================================================================


// ----------------------------------------------------------------------------
// Вспомогательная арифметика
// ----------------------------------------------------------------------------

Функция Остаток(Знач А, Знач Б) Экспорт
	Возврат А - Цел(А / Б) * Б;
КонецФункции

// В этой версии платформы нет ни Степень(), ни битовых функций (БитИ и
// подобные) — обе попытки положиться на "стандартные" платформенные функции
// не подтвердились на практике. Ниже — их самодельные замены на чистой
// арифметике (умножение/деление/остаток), без каких-либо предположений о
// том, что ещё может быть в платформе.

Функция ДваВСтепени(Знач N) Экспорт
	Результат = 1;
	Для Индекс = 1 По N Цикл
		Результат = Результат * 2;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Побитовое И для чисел 0..2^32-1: раскладываем оба числа по битам (через
// деление/остаток на 2) и сравниваем бит за битом — 32 бита, максимум просто.
Функция БитовоеИ(Знач X, Знач Y) Экспорт
	Результат = 0;
	МножительБита = 1;
	ТекX = X;
	ТекY = Y;
	Для Индекс = 1 По 32 Цикл
		Если Остаток(ТекX, 2) = 1 И Остаток(ТекY, 2) = 1 Тогда
			Результат = Результат + МножительБита;
		КонецЕсли;
		ТекX = Цел(ТекX / 2);
		ТекY = Цел(ТекY / 2);
		МножительБита = МножительБита * 2;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция БитовоеИсключающееИЛИ(Знач X, Знач Y) Экспорт
	Результат = 0;
	МножительБита = 1;
	ТекX = X;
	ТекY = Y;
	Для Индекс = 1 По 32 Цикл
		Если Остаток(ТекX, 2) <> Остаток(ТекY, 2) Тогда
			Результат = Результат + МножительБита;
		КонецЕсли;
		ТекX = Цел(ТекX / 2);
		ТекY = Цел(ТекY / 2);
		МножительБита = МножительБита * 2;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Побитовое НЕ для 32-битного числа — это просто (2^32 - 1) - X, потому что
// переворот всех битов и вычитание из "все единицы" — одно и то же.
Функция БитовоеНЕ(Знач X) Экспорт
	Возврат 4294967295 - X;
КонецФункции


// ----------------------------------------------------------------------------
// Base64 / Base64url
// ----------------------------------------------------------------------------

Функция Base64Alphabet(Знач ДляUrl) Экспорт
	Если ДляUrl Тогда
		Возврат "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
	Иначе
		Возврат "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
	КонецЕсли;
КонецФункции

// МассивБайт — Массив чисел 0..255. ДляUrl=Истина — без паддинга "=" (JWT).
Функция Base64Encode(Знач МассивБайт, Знач ДляUrl = Ложь) Экспорт
	Алфавит = Base64Alphabet(ДляUrl);
	Результат = "";
	Длина = МассивБайт.Количество();
	Индекс = 0;

	Пока Индекс < Длина Цикл
		Б0 = МассивБайт[Индекс];
		Если Индекс + 1 < Длина Тогда
			Б1 = МассивБайт[Индекс + 1];
		Иначе
			Б1 = 0;
		КонецЕсли;
		Если Индекс + 2 < Длина Тогда
			Б2 = МассивБайт[Индекс + 2];
		Иначе
			Б2 = 0;
		КонецЕсли;

		Триплет = Б0 * 65536 + Б1 * 256 + Б2;

		С0 = Цел(Триплет / 262144);
		С1 = Остаток(Цел(Триплет / 4096), 64);
		С2 = Остаток(Цел(Триплет / 64), 64);
		С3 = Остаток(Триплет, 64);

		Результат = Результат + Сред(Алфавит, С0 + 1, 1);
		Результат = Результат + Сред(Алфавит, С1 + 1, 1);

		Если Индекс + 1 < Длина Тогда
			Результат = Результат + Сред(Алфавит, С2 + 1, 1);
		ИначеЕсли Не ДляUrl Тогда
			Результат = Результат + "=";
		КонецЕсли;

		Если Индекс + 2 < Длина Тогда
			Результат = Результат + Сред(Алфавит, С3 + 1, 1);
		ИначеЕсли Не ДляUrl Тогда
			Результат = Результат + "=";
		КонецЕсли;

		Индекс = Индекс + 3;
	КонецЦикла;

	Возврат Результат;
КонецФункции

Функция Base64ИндексСимвола(Знач Символ) Экспорт
	Стандартный = Base64Alphabet(Ложь);
	Позиция = СтрНайти(Стандартный, Символ);
	Если Позиция > 0 Тогда
		Возврат Позиция - 1;
	КонецЕсли;
	УрлВариант = Base64Alphabet(Истина);
	Позиция = СтрНайти(УрлВариант, Символ);
	Если Позиция > 0 Тогда
		Возврат Позиция - 1;
	КонецЕсли;
	Возврат -1;
КонецФункции

// Понимает и обычный Base64 (с +/  и «=»), и Base64url (-/_ без паддинга).
// Нужен только для чтения PEM-ключа — сам ключ всегда в обычном Base64.
Функция Base64Decode(Знач Строка) Экспорт
	Очищенная = "";
	Для Индекс = 1 По СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Индекс, 1);
		Если Base64ИндексСимвола(Символ) >= 0 Тогда
			Очищенная = Очищенная + Символ;
		КонецЕсли;
	КонецЦикла;

	Результат = Новый Массив;
	Длина = СтрДлина(Очищенная);
	Индекс = 1;

	Пока Индекс <= Длина Цикл
		С0 = Base64ИндексСимвола(Сред(Очищенная, Индекс, 1));
		Если Индекс + 1 <= Длина Тогда
			С1 = Base64ИндексСимвола(Сред(Очищенная, Индекс + 1, 1));
		Иначе
			С1 = -1;
		КонецЕсли;
		Если Индекс + 2 <= Длина Тогда
			С2 = Base64ИндексСимвола(Сред(Очищенная, Индекс + 2, 1));
		Иначе
			С2 = -1;
		КонецЕсли;
		Если Индекс + 3 <= Длина Тогда
			С3 = Base64ИндексСимвола(Сред(Очищенная, Индекс + 3, 1));
		Иначе
			С3 = -1;
		КонецЕсли;

		Если С1 < 0 Тогда
			Прервать;
		КонецЕсли;

		Результат.Добавить(С0 * 4 + Цел(С1 / 16));

		Если С2 >= 0 Тогда
			Результат.Добавить(Остаток(С1, 16) * 16 + Цел(С2 / 4));
		КонецЕсли;

		Если С3 >= 0 Тогда
			Результат.Добавить(Остаток(С2, 4) * 64 + С3);
		КонецЕсли;

		Индекс = Индекс + 4;
	КонецЦикла;

	Возврат Результат;
КонецФункции

// Строка в байты в кодировке UTF-8.
//
// Для самого JWT достаточно было бы ASCII (там только base64url-символы), но
// наивный вариант «байт = КодСимвола()» тихо давал бы неверный хэш на любом
// тексте с кириллицей — мина на будущее. Здесь честный UTF-8, собранный на
// арифметике, поскольку битовых операций в этой версии платформы нет.
Функция СтрокаВБайты(Знач Текст) Экспорт
	Байты = Новый Массив;
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Код = КодСимвола(Текст, Индекс);
		Если Код < 128 Тогда
			Байты.Добавить(Код);
		ИначеЕсли Код < 2048 Тогда
			Байты.Добавить(192 + Цел(Код / 64));
			Байты.Добавить(128 + Остаток(Код, 64));
		Иначе
			Байты.Добавить(224 + Цел(Код / 4096));
			Байты.Добавить(128 + Остаток(Цел(Код / 64), 64));
			Байты.Добавить(128 + Остаток(Код, 64));
		КонецЕсли;
	КонецЦикла;
	Возврат Байты;
КонецФункции

// Целое число в строку БЕЗ разделителей разрядов.
//
// Нельзя брать штатное Строка(Число): оно форматирует по региональным
// настройкам и для 1755000000 вернёт «1 755 000 000» с пробелами. В JSON
// такое значение сломает разбор, и Google молча отвергнет токен — ошибка,
// которую потом искали бы очень долго. Здесь только арифметика.
Функция ЧислоВСтроку(Знач Ч) Экспорт
	Если Ч = 0 Тогда
		Возврат "0";
	КонецЕсли;
	Цифры = "0123456789";
	Результат = "";
	Текущее = Ч;
	Пока Текущее > 0 Цикл
		Цифра = Остаток(Текущее, 10);
		Результат = Сред(Цифры, Цифра + 1, 1) + Результат;
		Текущее = Цел(Текущее / 10);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ВHex(Знач Байты) Экспорт
	Алфавит = "0123456789abcdef";
	Результат = "";
	Для Каждого Б Из Байты Цикл
		Результат = Результат + Сред(Алфавит, Цел(Б / 16) + 1, 1) + Сред(Алфавит, Остаток(Б, 16) + 1, 1);
	КонецЦикла;
	Возврат Результат;
КонецФункции


// ----------------------------------------------------------------------------
// SHA-256 (FIPS 180-4). Стандартные константы, стандартный алгоритм.
// ----------------------------------------------------------------------------

Функция SHA256_Mod32(Знач X) Экспорт
	Возврат X - Цел(X / 4294967296) * 4294967296;
КонецФункции

Функция SHA256_RotR(Знач X, Знач N) Экспорт
	Делитель = ДваВСтепени(N);
	ПравыйСдвиг = Цел(X / Делитель);
	ЛевыйОстаток = X - ПравыйСдвиг * Делитель;
	ЛевыйСдвинутый = ЛевыйОстаток * ДваВСтепени(32 - N);
	Возврат SHA256_Mod32(ПравыйСдвиг + ЛевыйСдвинутый);
КонецФункции

Функция SHA256_ShR(Знач X, Знач N) Экспорт
	Возврат Цел(X / ДваВСтепени(N));
КонецФункции

Функция SHA256_Ch(Знач X, Знач Y, Знач Z) Экспорт
	Возврат SHA256_Mod32(БитовоеИсключающееИЛИ(БитовоеИ(X, Y), БитовоеИ(БитовоеНЕ(X), Z)));
КонецФункции

Функция SHA256_Maj(Знач X, Знач Y, Знач Z) Экспорт
	Возврат SHA256_Mod32(БитовоеИсключающееИЛИ(БитовоеИсключающееИЛИ(БитовоеИ(X, Y), БитовоеИ(X, Z)), БитовоеИ(Y, Z)));
КонецФункции

Функция SHA256_БольшаяСигма0(Знач X) Экспорт
	Возврат SHA256_Mod32(БитовоеИсключающееИЛИ(БитовоеИсключающееИЛИ(SHA256_RotR(X, 2), SHA256_RotR(X, 13)), SHA256_RotR(X, 22)));
КонецФункции

Функция SHA256_БольшаяСигма1(Знач X) Экспорт
	Возврат SHA256_Mod32(БитовоеИсключающееИЛИ(БитовоеИсключающееИЛИ(SHA256_RotR(X, 6), SHA256_RotR(X, 11)), SHA256_RotR(X, 25)));
КонецФункции

Функция SHA256_МалаяСигма0(Знач X) Экспорт
	Возврат SHA256_Mod32(БитовоеИсключающееИЛИ(БитовоеИсключающееИЛИ(SHA256_RotR(X, 7), SHA256_RotR(X, 18)), SHA256_ShR(X, 3)));
КонецФункции

Функция SHA256_МалаяСигма1(Знач X) Экспорт
	Возврат SHA256_Mod32(БитовоеИсключающееИЛИ(БитовоеИсключающееИЛИ(SHA256_RotR(X, 17), SHA256_RotR(X, 19)), SHA256_ShR(X, 10)));
КонецФункции

