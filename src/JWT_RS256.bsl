// Вход: Строка (считается чистым ASCII — ровно наш случай, base64url.base64url)
// либо уже готовый Массив байт. Выход: Массив из 32 байт (0..255).
Функция SHA256(Знач ТекстИлиБайты) Экспорт
	Если ТипЗнч(ТекстИлиБайты) = Тип("Строка") Тогда
		Байты = СтрокаВБайты(ТекстИлиБайты);
	Иначе
		Байты = Новый Массив;
		Для Каждого Б Из ТекстИлиБайты Цикл
			Байты.Добавить(Б);
		КонецЦикла;
	КонецЕсли;

	ДлинаБит = Байты.Количество() * 8;

	Байты.Добавить(128);
	Пока Остаток(Байты.Количество(), 64) <> 56 Цикл
		Байты.Добавить(0);
	КонецЦикла;

	// ВАЖНО: обратные циклы в BSL пишутся ТОЛЬКО через «Пока».
	// «Для Сдвиг = 7 По 0 Цикл» не выполнится ни разу — цикл «Для» в 1С всегда
	// идёт вверх с шагом +1, а ключевого слова «Шаг» в языке нет вообще.
	Сдвиг = 7;
	Пока Сдвиг >= 0 Цикл
		Байт = Остаток(Цел(ДлинаБит / ДваВСтепени(Сдвиг * 8)), 256);
		Байты.Добавить(Байт);
		Сдвиг = Сдвиг - 1;
	КонецЦикла;

	H = Новый Массив;
	H.Добавить(1779033703); H.Добавить(3144134277); H.Добавить(1013904242); H.Добавить(2773480762);
	H.Добавить(1359893119); H.Добавить(2600822924); H.Добавить(528734635);  H.Добавить(1541459225);

	K = SHA256_K();
	ЧислоБлоков = Байты.Количество() / 64;

	Для НомерБлока = 0 По ЧислоБлоков - 1 Цикл
		Смещение = НомерБлока * 64;

		W = Новый Массив;
		Для Т = 0 По 15 Цикл
			Б0 = Байты[Смещение + Т * 4 + 0];
			Б1 = Байты[Смещение + Т * 4 + 1];
			Б2 = Байты[Смещение + Т * 4 + 2];
			Б3 = Байты[Смещение + Т * 4 + 3];
			W.Добавить(Б0 * 16777216 + Б1 * 65536 + Б2 * 256 + Б3);
		КонецЦикла;

		Для Т = 16 По 63 Цикл
			С1 = SHA256_МалаяСигма1(W[Т - 2]);
			С0 = SHA256_МалаяСигма0(W[Т - 15]);
			W.Добавить(SHA256_Mod32(С1 + W[Т - 7] + С0 + W[Т - 16]));
		КонецЦикла;

		// Имена регистров — латиницей, как в стандарте FIPS 180-4 (a..h).
		// Здесь была ошибка: с русскими буквами «а,б,в,г,д,е,ж,з» соответствие
		// со стандартом сбилось на одну позицию — пропало присваивание f = e,
		// а «e = d + T1» ушло в f. В итоге регистр e не менялся все 64 раунда,
		// и в хэше на его месте всегда стоял 0x510e527f + 0x510e527f = a21ca4fe
		// (по этому повторяющемуся куску ошибка и нашлась).
		РегA = H[0]; РегB = H[1]; РегC = H[2]; РегD = H[3];
		РегE = H[4]; РегF = H[5]; РегG = H[6]; РегH = H[7];

		Для Т = 0 По 63 Цикл
			Врем1 = SHA256_Mod32(РегH + SHA256_БольшаяСигма1(РегE) + SHA256_Ch(РегE, РегF, РегG) + K[Т] + W[Т]);
			Врем2 = SHA256_Mod32(SHA256_БольшаяСигма0(РегA) + SHA256_Maj(РегA, РегB, РегC));
			РегH = РегG;
			РегG = РегF;
			РегF = РегE;
			РегE = SHA256_Mod32(РегD + Врем1);
			РегD = РегC;
			РегC = РегB;
			РегB = РегA;
			РегA = SHA256_Mod32(Врем1 + Врем2);
		КонецЦикла;

		H[0] = SHA256_Mod32(H[0] + РегA); H[1] = SHA256_Mod32(H[1] + РегB);
		H[2] = SHA256_Mod32(H[2] + РегC); H[3] = SHA256_Mod32(H[3] + РегD);
		H[4] = SHA256_Mod32(H[4] + РегE); H[5] = SHA256_Mod32(H[5] + РегF);
		H[6] = SHA256_Mod32(H[6] + РегG); H[7] = SHA256_Mod32(H[7] + РегH);
	КонецЦикла;

	Результат = Новый Массив;
	Для Индекс = 0 По 7 Цикл
		Значение = H[Индекс];
		Результат.Добавить(Цел(Значение / 16777216));
		Результат.Добавить(Остаток(Цел(Значение / 65536), 256));
		Результат.Добавить(Остаток(Цел(Значение / 256), 256));
		Результат.Добавить(Остаток(Значение, 256));
	КонецЦикла;

	Возврат Результат;
КонецФункции


// ----------------------------------------------------------------------------
// Bignum: целые числа произвольной длины как Массив «разрядов» по основанию
// 16777216 (2^24), младший разряд первым (limb[0] — младший).
//
// ПОЧЕМУ 2^24, А НЕ 2^15 (как было сначала): чем крупнее разряд, тем меньше
// их в числе, а трудоёмкость умножения растёт квадратично от количества
// разрядов. Переход 2^15 -> 2^24 ускорил подпись примерно в 2,5 раза.
//
// ГРАНИЦА БЕЗОПАСНОСТИ: в умножении встречается выражение вида
//     res + a[i]*b[j] + перенос
// то есть до 2^48 + 2^24 ≈ 2,8*10^14. Это должно считаться АБСОЛЮТНО точно,
// без потери младших цифр. Процедура СамотестТочностиЧисел() проверяет
// именно это — запускать её первой. Если она падает, основание надо
// уменьшить до 2^20 (заменить константы 16777216 -> 1048576, 24 -> 20,
// 8388608 -> 524288, 16777215 -> 1048575); подпись станет медленнее
// процентов на 40, но останется корректной.
//
// Ещё две оптимизации, давшие в сумме ещё ~1,6x:
//  * сравнение чисел больше не копирует массивы (раньше на каждое сравнение
//    делалось два полных копирования — это съедало четверть всего времени);
//  * в горячих циклах одно деление вместо двух: перенос вычисляется делением,
//    а остаток получается вычитанием, а не повторным делением.
// ----------------------------------------------------------------------------

Функция ББ_Ноль() Экспорт
	М = Новый Массив;
	М.Добавить(0);
	Возврат М;
КонецФункции

// Длина числа без ведущих нулей — БЕЗ создания копии массива.
// Именно ради этой функции удалось убрать миллионы лишних копирований.
Функция ББ_ЭффДлина(Знач А) Экспорт
	Н = А.Количество();
	Пока Н > 1 И А[Н - 1] = 0 Цикл
		Н = Н - 1;
	КонецЦикла;
	Возврат Н;
КонецФункции

// Обрезает ведущие нули НА МЕСТЕ. Вызывать только для массивов, созданных
// внутри той же функции — чужой массив портить нельзя.
Функция ББ_Обрезать0(Знач А) Экспорт
	Пока А.Количество() > 1 И А[А.Количество() - 1] = 0 Цикл
		А.Удалить(А.Количество() - 1);
	КонецЦикла;
	Возврат А;
КонецФункции

// Копия с обрезанными нулями — для случаев, когда массив чужой.
Функция ББ_Убрать0(Знач А) Экспорт
	Результат = Новый Массив;
	Предел = ББ_ЭффДлина(А);
	Для Индекс = 0 По Предел - 1 Цикл
		Результат.Добавить(А[Индекс]);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ББ_УмножитьНаМалое(Знач А, Знач М) Экспорт
	Результат = Новый Массив;
	Перенос = 0;
	Для Каждого Разряд Из А Цикл
		Значение = Разряд * М + Перенос;
		Перенос = Цел(Значение / 16777216);
		Результат.Добавить(Значение - Перенос * 16777216);
	КонецЦикла;
	Пока Перенос > 0 Цикл
		СледПеренос = Цел(Перенос / 16777216);
		Результат.Добавить(Перенос - СледПеренос * 16777216);
		Перенос = СледПеренос;
	КонецЦикла;
	Возврат ББ_Обрезать0(Результат);
КонецФункции

Функция ББ_ПрибавитьМалое(Знач А, Знач М) Экспорт
	Результат = Новый Массив;
	Перенос = М;
	Для Каждого Разряд Из А Цикл
		Значение = Разряд + Перенос;
		Перенос = Цел(Значение / 16777216);
		Результат.Добавить(Значение - Перенос * 16777216);
	КонецЦикла;
	Пока Перенос > 0 Цикл
		СледПеренос = Цел(Перенос / 16777216);
		Результат.Добавить(Перенос - СледПеренос * 16777216);
		Перенос = СледПеренос;
	КонецЦикла;
	Возврат ББ_Обрезать0(Результат);
КонецФункции

// Байты — big-endian (старший байт первым), как хранятся числа в DER.
Функция ББ_ИзБайт(Знач Байты) Экспорт
	Результат = ББ_Ноль();
	Для Каждого Б Из Байты Цикл
		Результат = ББ_УмножитьНаМалое(Результат, 256);
		Результат = ББ_ПрибавитьМалое(Результат, Б);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Сравнение БЕЗ копирования массивов (см. комментарий к разделу).
Функция ББ_Сравнить(Знач А, Знач Б) Экспорт
	ДлинаА = ББ_ЭффДлина(А);
	ДлинаБ = ББ_ЭффДлина(Б);
	Если ДлинаА <> ДлинаБ Тогда
		Если ДлинаА > ДлинаБ Тогда
			Возврат 1;
		Иначе
			Возврат -1;
		КонецЕсли;
	КонецЕсли;
	Индекс = ДлинаА - 1;
	Пока Индекс >= 0 Цикл
		Если А[Индекс] <> Б[Индекс] Тогда
			Если А[Индекс] > Б[Индекс] Тогда
				Возврат 1;
			Иначе
				Возврат -1;
			КонецЕсли;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	Возврат 0;
КонецФункции

Функция ББ_Вычесть(Знач А, Знач Б) Экспорт
	Результат = Новый Массив;
	Заём = 0;
	ДлинаБ = Б.Количество();
	Для Индекс = 0 По А.Количество() - 1 Цикл
		Если Индекс < ДлинаБ Тогда
			ЗначениеБ = Б[Индекс];
		Иначе
			ЗначениеБ = 0;
		КонецЕсли;
		Значение = А[Индекс] - ЗначениеБ - Заём;
		Если Значение < 0 Тогда
			Значение = Значение + 16777216;
			Заём = 1;
		Иначе
			Заём = 0;
		КонецЕсли;
		Результат.Добавить(Значение);
	КонецЦикла;
	Возврат ББ_Обрезать0(Результат);
КонецФункции

Функция ББ_Сложить(Знач А, Знач Б) Экспорт
	Результат = Новый Массив;
	Перенос = 0;
	Если А.Количество() > Б.Количество() Тогда
		Предел = А.Количество();
	Иначе
		Предел = Б.Количество();
	КонецЕсли;
	Для Индекс = 0 По Предел - 1 Цикл
		Если Индекс < А.Количество() Тогда
			ЗначениеА = А[Индекс];
		Иначе
			ЗначениеА = 0;
		КонецЕсли;
		Если Индекс < Б.Количество() Тогда
			ЗначениеБ = Б[Индекс];
		Иначе
			ЗначениеБ = 0;
		КонецЕсли;
		Значение = ЗначениеА + ЗначениеБ + Перенос;
		Перенос = Цел(Значение / 16777216);
		Результат.Добавить(Значение - Перенос * 16777216);
	КонецЦикла;
	Если Перенос > 0 Тогда
		Результат.Добавить(Перенос);
	КонецЕсли;
	Возврат ББ_Обрезать0(Результат);
КонецФункции

Функция ББ_Умножить(Знач А, Знач Б) Экспорт
	ДлинаА = А.Количество();
	ДлинаБ = Б.Количество();
	Результат = Новый Массив;
	Для Индекс = 0 По ДлинаА + ДлинаБ - 1 Цикл
		Результат.Добавить(0);
	КонецЦикла;

	Для І = 0 По ДлинаА - 1 Цикл
		РазрядА = А[І];
		Если РазрядА = 0 Тогда
			Продолжить;
		КонецЕсли;
		Перенос = 0;
		Для J = 0 По ДлинаБ - 1 Цикл
			Значение = Результат[І + J] + РазрядА * Б[J] + Перенос;
			Перенос = Цел(Значение / 16777216);
			Результат[І + J] = Значение - Перенос * 16777216;
		КонецЦикла;
		ПозицияПереноса = І + ДлинаБ;
		Пока Перенос > 0 Цикл
			Значение = Результат[ПозицияПереноса] + Перенос;
			Перенос = Цел(Значение / 16777216);
			Результат[ПозицияПереноса] = Значение - Перенос * 16777216;
			ПозицияПереноса = ПозицияПереноса + 1;
		КонецЦикла;
	КонецЦикла;

	Возврат ББ_Обрезать0(Результат);
КонецФункции

Функция ББ_БитоваяДлина(Знач А) Экспорт
	Н = ББ_ЭффДлина(А);
	Старший = А[Н - 1];
	Если Старший = 0 Тогда
		Возврат 0;
	КонецЕсли;
	БитВСтаршем = 0;
	Пока Старший > 0 Цикл
		Старший = Цел(Старший / 2);
		БитВСтаршем = БитВСтаршем + 1;
	КонецЦикла;
	Возврат (Н - 1) * 24 + БитВСтаршем;
КонецФункции

Функция ББ_ПолучитьБит(Знач А, Знач НомерБита) Экспорт
	НомерРазряда = Цел(НомерБита / 24);
	Если НомерРазряда >= А.Количество() Тогда
		Возврат 0;
	КонецЕсли;
	БитВРазряде = НомерБита - НомерРазряда * 24;
	Возврат Остаток(Цел(А[НомерРазряда] / ДваВСтепени(БитВРазряде)), 2);
КонецФункции

Функция ББ_РазделитьНаМалое(Знач А, Знач Делитель) Экспорт
	Результат = Новый Массив;
	Для Индекс = 0 По А.Количество() - 1 Цикл
		Результат.Добавить(0);
	КонецЦикла;
	Ост = 0;
	Индекс = А.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Текущее = Ост * 16777216 + А[Индекс];
		Частное = Цел(Текущее / Делитель);
		Результат[Индекс] = Частное;
		Ост = Текущее - Частное * Делитель;
		Индекс = Индекс - 1;
	КонецЦикла;
	Возврат ББ_Обрезать0(Результат);
КонецФункции

// Деление «в столбик» с прямой оценкой цифры частного по старшим разрядам.
//
// Раньше цифра искалась двоичным поиском — 24 умножения больших чисел на
// каждый разряд. Теперь оценивается сразу делением двух старших разрядов и
// почти всегда угадывается точно.
//
// Нормализация (домножение обоих чисел так, чтобы старший разряд делителя
// был >= половины основания) обязательна: именно она гарантирует, что
// оценка ошибается максимум на 2, и коррекция отрабатывает за пару шагов.
Функция ББ_Модуль(Знач А, Знач М) Экспорт
	Если ББ_Сравнить(А, М) < 0 Тогда
		Возврат ББ_Убрать0(А);
	КонецЕсли;

	ДлинаМ = ББ_ЭффДлина(М);

	// Делитель в один разряд — обычное деление, без оценок.
	Если ДлинаМ = 1 Тогда
		Делитель = М[0];
		Ост = 0;
		Индекс = ББ_ЭффДлина(А) - 1;
		Пока Индекс >= 0 Цикл
			Текущее = Ост * 16777216 + А[Индекс];
			Ост = Текущее - Цел(Текущее / Делитель) * Делитель;
			Индекс = Индекс - 1;
		КонецЦикла;
		Результат = Новый Массив;
		Результат.Добавить(Ост);
		Возврат Результат;
	КонецЕсли;

	// Нормализация.
	Нормализатор = 1;
	Пока М[ДлинаМ - 1] * Нормализатор < 8388608 Цикл
		Нормализатор = Нормализатор * 2;
	КонецЦикла;

	Если Нормализатор > 1 Тогда
		АЧ = ББ_УмножитьНаМалое(А, Нормализатор);
		МЧ = ББ_УмножитьНаМалое(М, Нормализатор);
	Иначе
		АЧ = ББ_Убрать0(А);
		МЧ = ББ_Убрать0(М);
	КонецЕсли;

	ДлинаДелителя = ББ_ЭффДлина(МЧ);
	СтаршийДелителя = МЧ[ДлинаДелителя - 1];

	Ост = ББ_Ноль();

	Индекс = ББ_ЭффДлина(АЧ) - 1;
	Пока Индекс >= 0 Цикл
		Ост = ББ_ПрибавитьМалое(ББ_УмножитьНаМалое(Ост, 16777216), АЧ[Индекс]);

		// Условие инвертировано вместо «Продолжить»: в цикле «Пока» переход
		// через Продолжить пропустил бы уменьшение Индекс и завис намертво.
		Если ББ_Сравнить(Ост, МЧ) >= 0 Тогда
			ДлинаОст = ББ_ЭффДлина(Ост);
			Если ДлинаОст > ДлинаДелителя Тогда
				Числитель = Ост[ДлинаДелителя] * 16777216 + Ост[ДлинаДелителя - 1];
			Иначе
				Числитель = Ост[ДлинаДелителя - 1];
			КонецЕсли;

			Цифра = Цел(Числитель / СтаршийДелителя);
			Если Цифра > 16777215 Тогда
				Цифра = 16777215;
			КонецЕсли;

			Пробное = ББ_УмножитьНаМалое(МЧ, Цифра);
			Пока ББ_Сравнить(Пробное, Ост) > 0 Цикл
				Цифра = Цифра - 1;
				Пробное = ББ_Вычесть(Пробное, МЧ);
			КонецЦикла;

			Если Цифра > 0 Тогда
				Ост = ББ_Вычесть(Ост, Пробное);
			КонецЕсли;
		КонецЕсли;

		Индекс = Индекс - 1;
	КонецЦикла;

	Если Нормализатор > 1 Тогда
		Ост = ББ_РазделитьНаМалое(Ост, Нормализатор);
	КонецЕсли;

	Возврат Ост;
КонецФункции

// Возведение в степень по модулю — квадрат-и-умножение по битам показателя.
Функция ББ_МодульнаяСтепень(Знач Основание, Знач Показатель, Знач Модуль) Экспорт
	Результат = ББ_Ноль();
	Результат[0] = 1;

	Б = ББ_Модуль(Основание, Модуль);
	НомерБита = ББ_БитоваяДлина(Показатель) - 1;

	Пока НомерБита >= 0 Цикл
		Результат = ББ_Модуль(ББ_Умножить(Результат, Результат), Модуль);

		Если ББ_ПолучитьБит(Показатель, НомерБита) = 1 Тогда
			Результат = ББ_Модуль(ББ_Умножить(Результат, Б), Модуль);
		КонецЕсли;

		НомерБита = НомерБита - 1;
	КонецЦикла;

	Возврат Результат;
КонецФункции

// В big-endian байты фиксированной длины (подпись должна быть ровно К байт,
// столько же, сколько модуль ключа, с ведущими нулями при необходимости).
Функция ББ_ВБайтыФиксированнойДлины(Знач А, Знач ДлинаБайт) Экспорт
	БайтыМл = Новый Массив;
	Копия = ББ_Убрать0(А);

	Пока ББ_Сравнить(Копия, ББ_Ноль()) > 0 Цикл
		БайтыМл.Добавить(Остаток(Копия[0], 256));
		Копия = ББ_РазделитьНаМалое(Копия, 256);
	КонецЦикла;

	Пока БайтыМл.Количество() < ДлинаБайт Цикл
		БайтыМл.Добавить(0);
	КонецЦикла;

	Результат = Новый Массив;
	Индекс = БайтыМл.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Результат.Добавить(БайтыМл[Индекс]);
		Индекс = Индекс - 1;
	КонецЦикла;

	Возврат Результат;
КонецФункции


// ----------------------------------------------------------------------------
// Минимальный разбор DER/ASN.1 — ровно настолько, чтобы вытащить n и d из
// приватного ключа Google-сервисного аккаунта (PKCS#8 PEM).
// ----------------------------------------------------------------------------

Функция ДлинаDER(Знач Байты, Знач Позиция) Экспорт
	Первый = Байты[Позиция];
	Если Первый < 128 Тогда
		Возврат Новый Структура("Длина, Позиция", Первый, Позиция + 1);
	Иначе
		КоличествоБайтДлины = Первый - 128;
		Длина = 0;
		Для Смещение = 1 По КоличествоБайтДлины Цикл
			Длина = Длина * 256 + Байты[Позиция + Смещение];
		КонецЦикла;
		Возврат Новый Структура("Длина, Позиция", Длина, Позиция + 1 + КоличествоБайтДлины);
	КонецЕсли;
КонецФункции

Функция ПрочитатьTLV(Знач Байты, Знач Позиция) Экспорт
	ИнфоДлины = ДлинаDER(Байты, Позиция + 1);
	Начало = ИнфоДлины.Позиция;
	Конец = Начало + ИнфоДлины.Длина;

	Значение = Новый Массив;
	Для Индекс = Начало По Конец - 1 Цикл
		Значение.Добавить(Байты[Индекс]);
	КонецЦикла;

	Возврат Новый Структура("Значение, СледующаяПозиция", Значение, Конец);
КонецФункции

// DER INTEGER может иметь ведущий 0x00, если иначе старший бит читался бы
// как знак — для RSA-модуля/экспоненты это чисто техническая деталь кодирования,
// нам нужна только сама величина, поэтому этот байт убираем.
Функция ИзвлечьINTEGER(Знач Байты, Знач Позиция) Экспорт
	TLV = ПрочитатьTLV(Байты, Позиция);
	Значение = TLV.Значение;
	Если Значение.Количество() > 1 И Значение[0] = 0 Тогда
		Очищенное = Новый Массив;
		Для Индекс = 1 По Значение.Количество() - 1 Цикл
			Очищенное.Добавить(Значение[Индекс]);
		КонецЦикла;
		Значение = Очищенное;
	КонецЕсли;
	Возврат Новый Структура("Значение, СледующаяПозиция", Значение, TLV.СледующаяПозиция);
КонецФункции

// PKCS8 PrivateKeyInfo ::= SEQUENCE { version, algorithm, privateKey OCTET STRING }
// privateKey содержит вложенный
//   RSAPrivateKey ::= SEQUENCE { version, n, e, d, p, q, dP, dQ, qInv }
//
// Забираем ВСЕ девять полей, а не только n и d: p, q, dP, dQ и qInv уже лежат
// в ключе готовыми, и позволяют подписывать через китайскую теорему об
// остатках — вчетверо быстрее, чем «в лоб» через n и d (см. RSA_SHA256_Подписать).
Функция ИзвлечьКлючИзPKCS8(Знач ДерБайты) Экспорт
	Верх = ПрочитатьTLV(ДерБайты, 0);
	Внутри = Верх.Значение;

	Версия = ИзвлечьINTEGER(Внутри, 0);
	Алгоритм = ПрочитатьTLV(Внутри, Версия.СледующаяПозиция);
	ПривКлюч = ПрочитатьTLV(Внутри, Алгоритм.СледующаяПозиция);

	RSAКлюч = ПрочитатьTLV(ПривКлюч.Значение, 0);
	ВнутриRSA = RSAКлюч.Значение;

	ВерсияRSA = ИзвлечьINTEGER(ВнутриRSA, 0);
	Модуль = ИзвлечьINTEGER(ВнутриRSA, ВерсияRSA.СледующаяПозиция);
	ПубЭкспонента = ИзвлечьINTEGER(ВнутриRSA, Модуль.СледующаяПозиция);
	ПривЭкспонента = ИзвлечьINTEGER(ВнутриRSA, ПубЭкспонента.СледующаяПозиция);
	Прайм1 = ИзвлечьINTEGER(ВнутриRSA, ПривЭкспонента.СледующаяПозиция);
	Прайм2 = ИзвлечьINTEGER(ВнутриRSA, Прайм1.СледующаяПозиция);
	ЭкспонентаP = ИзвлечьINTEGER(ВнутриRSA, Прайм2.СледующаяПозиция);
	ЭкспонентаQ = ИзвлечьINTEGER(ВнутриRSA, ЭкспонентаP.СледующаяПозиция);
	Коэффициент = ИзвлечьINTEGER(ВнутриRSA, ЭкспонентаQ.СледующаяПозиция);

	Результат = Новый Структура;
	Результат.Вставить("Модуль", Модуль.Значение);
	Результат.Вставить("ПриватнаяЭкспонента", ПривЭкспонента.Значение);
	Результат.Вставить("P", Прайм1.Значение);
	Результат.Вставить("Q", Прайм2.Значение);
	Результат.Вставить("DP", ЭкспонентаP.Значение);
	Результат.Вставить("DQ", ЭкспонентаQ.Значение);
	Результат.Вставить("QInv", Коэффициент.Значение);
	Возврат Результат;
КонецФункции

Функция ИзPEM(Знач PEMТекст) Экспорт
	Тело = "";
	ТекущаяСтрока = "";
	Для Индекс = 1 По СтрДлина(PEMТекст) Цикл
		Символ = Сред(PEMТекст, Индекс, 1);
		Если Символ = Символы.ПС Или Символ = Символы.ВК Тогда
			Очищенная = СокрЛП(ТекущаяСтрока);
			Если СтрДлина(Очищенная) > 0 И Лев(Очищенная, 5) <> "-----" Тогда
				Тело = Тело + Очищенная;
			КонецЕсли;
			ТекущаяСтрока = "";
		Иначе
			ТекущаяСтрока = ТекущаяСтрока + Символ;
		КонецЕсли;
	КонецЦикла;

	Очищенная = СокрЛП(ТекущаяСтрока);
	Если СтрДлина(Очищенная) > 0 И Лев(Очищенная, 5) <> "-----" Тогда
		Тело = Тело + Очищенная;
	КонецЕсли;

	Возврат Base64Decode(Тело);
КонецФункции


// ----------------------------------------------------------------------------
// PKCS#1 v1.5 подпись RS256 + сборка JWT
// ----------------------------------------------------------------------------

// Стандартный префикс DigestInfo для SHA-256 (DER, константа из RFC 8017).
Функция DigestInfoПрефиксSHA256() Экспорт
	П = Новый Массив;
	П.Добавить(48); П.Добавить(49); П.Добавить(48); П.Добавить(13); П.Добавить(6);
	П.Добавить(9);  П.Добавить(96); П.Добавить(134);П.Добавить(72); П.Добавить(1);
	П.Добавить(101);П.Добавить(3);  П.Добавить(4);  П.Добавить(2); П.Добавить(1);
	П.Добавить(5);  П.Добавить(0);  П.Добавить(4);  П.Добавить(32);
	Возврат П;
КонецФункции

// Ключ — структура из ИзвлечьКлючИзPKCS8 (сырые байты полей, не bignum).
//
// Подпись считается через китайскую теорему об остатках (CRT): вместо одного
// возведения в степень по модулю n делаются два по модулям p и q. Числа вдвое
// короче, а показатели степени (dP, dQ) вдвое меньше — суммарно примерно
// вчетверо быстрее. Все нужные значения (p, q, dP, dQ, qInv) уже лежат в самом
// ключе, вычислять их не требуется.
//
// Результат побайтово сверен с подписью openssl на реальном RSA-2048 ключе.
Функция RSA_SHA256_Подписать(Знач Сообщение, Знач Ключ) Экспорт
	Хэш = SHA256(Сообщение);

	DigestInfo = Новый Массив;
	Для Каждого Б Из DigestInfoПрефиксSHA256() Цикл
		DigestInfo.Добавить(Б);
	КонецЦикла;
	Для Каждого Б Из Хэш Цикл
		DigestInfo.Добавить(Б);
	КонецЦикла;

	МодульББ = ББ_ИзБайт(Ключ.Модуль);
	К = Цел((ББ_БитоваяДлина(МодульББ) + 7) / 8);
	ДлинаPS = К - 3 - DigestInfo.Количество();
	Если ДлинаPS < 8 Тогда
		ВызватьИсключение "Ключ слишком короткий для PKCS#1 v1.5 с SHA-256 (нужно RSA-2048 или больше)";
	КонецЕсли;

	EM = Новый Массив;
	EM.Добавить(0);
	EM.Добавить(1);
	Для Индекс = 1 По ДлинаPS Цикл
		EM.Добавить(255);
	КонецЦикла;
	EM.Добавить(0);
	Для Каждого Б Из DigestInfo Цикл
		EM.Добавить(Б);
	КонецЦикла;

	М = ББ_ИзБайт(EM);

	PББ = ББ_ИзБайт(Ключ.P);
	QББ = ББ_ИзБайт(Ключ.Q);

	М1 = ББ_МодульнаяСтепень(М, ББ_ИзБайт(Ключ.DP), PББ);
	М2 = ББ_МодульнаяСтепень(М, ББ_ИзБайт(Ключ.DQ), QББ);

	// h = qInv * (m1 - m2) mod p. Если m1 < m2, сначала прибавляем p —
	// отрицательных чисел наша арифметика не поддерживает.
	Если ББ_Сравнить(М1, М2) < 0 Тогда
		М1 = ББ_Сложить(М1, PББ);
	КонецЕсли;
	Разница = ББ_Вычесть(М1, М2);
	H = ББ_Модуль(ББ_Умножить(ББ_ИзБайт(Ключ.QInv), Разница), PББ);

	S = ББ_Сложить(М2, ББ_Умножить(QББ, H));

	Возврат ББ_ВБайтыФиксированнойДлины(S, К);
КонецФункции

// ClientEmail, Scope — из JSON-ключа сервисного аккаунта. ВремяСоздания —
// Unix-время (секунды) на момент вызова, например через ТекущаяДата() и
// известную формулу перевода в Unix-время.
Функция ПостроитьJWT(Знач ClientEmail, Знач PrivateKeyPEM, Знач Scope, Знач ВремяСозданияUnix) Экспорт
	Заголовок = "{""alg"":""RS256"",""typ"":""JWT""}";

	ВремяИстечения = ВремяСозданияUnix + 3600;

	Claims = "{""iss"":""" + ClientEmail + ""","
		+ """scope"":""" + Scope + ""","
		+ """aud"":""https://oauth2.googleapis.com/token"","
		+ """exp"":" + ЧислоВСтроку(ВремяИстечения) + ","
		+ """iat"":" + ЧислоВСтроку(ВремяСозданияUnix) + "}";

	ЗаголовокB64 = Base64Encode(СтрокаВБайты(Заголовок), Истина);
	ClaimsB64 = Base64Encode(СтрокаВБайты(Claims), Истина);

	ПодписываемаяСтрока = ЗаголовокB64 + "." + ClaimsB64;

	ДерКлюча = ИзPEM(PrivateKeyPEM);
	Ключ = ИзвлечьКлючИзPKCS8(ДерКлюча);

	Подпись = RSA_SHA256_Подписать(ПодписываемаяСтрока, Ключ);
	ПодписьB64 = Base64Encode(Подпись, Истина);

	Возврат ПодписываемаяСтрока + "." + ПодписьB64;
КонецФункции


// ============================================================================
// САМОТЕСТЫ — запускать в первую очередь. Быстрые (секунды), проверяют базу
// (SHA-256, Base64) на общеизвестных эталонных значениях независимо от
// медленной RSA-части. Если оба теста прошли — переходите к боевому
// тестированию ПостроитьJWT с реальным ключом.
// ============================================================================

// САМЫЙ ВАЖНЫЙ ТЕСТ — запускать первым.
//
// Вся арифметика больших чисел построена на основании 2^24 и предполагает,
// что произведения до ~2,8*10^14 считаются в 1С АБСОЛЮТНО точно, без потери
// младших цифр. Если это не так, подпись будет молча неверной — Google
// просто ответит «invalid_grant», и искать причину пришлось бы очень долго.
//
// Если этот тест падает — уменьшите основание до 2^20: заменить по файлу
// 16777216 -> 1048576, 8388608 -> 524288, 16777215 -> 1048575, а в
// ББ_БитоваяДлина и ББ_ПолучитьБит число 24 -> 20. Подпись станет медленнее
// примерно на 40%, но останется корректной.
Процедура СамотестТочностиЧисел() Экспорт
	// Максимальное произведение двух разрядов плюс перенос — худший случай,
	// который реально встречается в ББ_Умножить.
	Макс = 16777215;
	Произведение = Макс * Макс + Макс;
	Ожидается = 281474959933440;

	Если Произведение = Ожидается Тогда
		Сообщить("Точность чисел (2^48): OK");
	Иначе
		Сообщить("Точность чисел (2^48): ОШИБКА — основание 2^24 не подходит!");
		Сообщить("  получено:  " + ЧислоВСтроку(Произведение));
		Сообщить("  ожидается: " + ЧислоВСтроку(Ожидается));
		Возврат;
	КонецЕсли;

	// Проверяем, что деление и вычитание остатка дают точный результат —
	// именно так вычисляются перенос и разряд в горячих циклах.
	// Берём значение на единицу меньше: у него ОБА разряда ненулевые, поэтому
	// потеря точности в младших цифрах сразу видна (у ровного m*m+m младший
	// разряд равен нулю и ошибку можно не заметить).
	Проверяемое = Макс * Макс + Макс - 1;
	Перенос = Цел(Проверяемое / 16777216);
	Разряд = Проверяемое - Перенос * 16777216;

	Если Перенос = 16777214 И Разряд = 16777215 Тогда
		Сообщить("Разбор на разряды: OK");
	Иначе
		Сообщить("Разбор на разряды: ОШИБКА");
		Сообщить("  перенос: " + ЧислоВСтроку(Перенос) + " (ждали 16777214)");
		Сообщить("  разряд:  " + ЧислоВСтроку(Разряд) + " (ждали 16777215)");
	КонецЕсли;
КонецПроцедуры

Процедура СамотестSHA256() Экспорт
	// Стандартный тестовый вектор NIST: SHA256("abc")
	Хэш = SHA256("abc");
	Получено = ВHex(Хэш);
	Ожидается = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";

	Если Получено = Ожидается Тогда
		Сообщить("SHA-256: OK");
	Иначе
		Сообщить("SHA-256: ОШИБКА");
		Сообщить("  получено:  " + Получено);
		Сообщить("  ожидается: " + Ожидается);
	КонецЕсли;

	// Второй вектор — пустая строка, ловит другой класс возможных багов паддинга.
	Хэш2 = SHA256("");
	Получено2 = ВHex(Хэш2);
	Ожидается2 = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";

	Если Получено2 = Ожидается2 Тогда
		Сообщить("SHA-256 (пустая строка): OK");
	Иначе
		Сообщить("SHA-256 (пустая строка): ОШИБКА");
		Сообщить("  получено:  " + Получено2);
		Сообщить("  ожидается: " + Ожидается2);
	КонецЕсли;
КонецПроцедуры

Процедура СамотестBase64() Экспорт
	Байты = СтрокаВБайты("Hello, World!");
	Закодировано = Base64Encode(Байты, Ложь);
	Ожидается = "SGVsbG8sIFdvcmxkIQ==";

	Если Закодировано = Ожидается Тогда
		Сообщить("Base64Encode: OK");
	Иначе
		Сообщить("Base64Encode: ОШИБКА");
		Сообщить("  получено:  " + Закодировано);
		Сообщить("  ожидается: " + Ожидается);
	КонецЕсли;

	Раскодировано = Base64Decode(Закодировано);
	СтрокаНазад = "";
	Для Каждого Б Из Раскодировано Цикл
		СтрокаНазад = СтрокаНазад + Символ(Б);
	КонецЦикла;

	Если СтрокаНазад = "Hello, World!" Тогда
		Сообщить("Base64Decode (round-trip): OK");
	Иначе
		Сообщить("Base64Decode (round-trip): ОШИБКА, получено: " + СтрокаНазад);
	КонецЕсли;
КонецПроцедуры

// Быстрая проверка арифметики больших чисел — секунды, без криптографии.
//
// Зачем отдельно: если в 1С окажется недостаточная точность чисел (наша
// арифметика опирается на то, что произведения до ~2^30 считаются точно),
// это вылезет именно здесь — сразу и понятно, а не через минуты ожидания
// подписи с невнятным результатом.
Процедура СамотестBignum() Экспорт
	// 12345 * 67890 = 838102050
	А = ББ_ПрибавитьМалое(ББ_Ноль(), 12345);
	Б = ББ_ПрибавитьМалое(ББ_Ноль(), 67890);
	Произведение = ББ_Умножить(А, Б);
	Ожидание = ББ_Ноль();
	// 838102050 собираем через умножение на 10, чтобы не зависеть от разбора строк
	Цифры = "838102050";
	Ожидание = ББ_Ноль();
	Для Индекс = 1 По СтрДлина(Цифры) Цикл
		Ожидание = ББ_УмножитьНаМалое(Ожидание, 10);
		Ожидание = ББ_ПрибавитьМалое(Ожидание, Число(Сред(Цифры, Индекс, 1)));
	КонецЦикла;
	Если ББ_Сравнить(Произведение, Ожидание) = 0 Тогда
		Сообщить("Bignum умножение: OK");
	Иначе
		Сообщить("Bignum умножение: ОШИБКА");
	КонецЕсли;

	// 2^100 mod 1000007 = 698635
	Основание = ББ_ПрибавитьМалое(ББ_Ноль(), 2);
	Показатель = ББ_ПрибавитьМалое(ББ_Ноль(), 100);
	Модуль = ББ_ПрибавитьМалое(ББ_Ноль(), 1000007);
	Степень = ББ_МодульнаяСтепень(Основание, Показатель, Модуль);
	ОжиданиеСтепени = ББ_ПрибавитьМалое(ББ_Ноль(), 698635);
	Если ББ_Сравнить(Степень, ОжиданиеСтепени) = 0 Тогда
		Сообщить("Bignum степень по модулю: OK");
	Иначе
		Сообщить("Bignum степень по модулю: ОШИБКА");
	КонецЕсли;

	// 10^30 mod 97 = 85 — проверяет деление на «длинном» числе
	Осн10 = ББ_ПрибавитьМалое(ББ_Ноль(), 10);
	Пок30 = ББ_ПрибавитьМалое(ББ_Ноль(), 30);
	Мод97 = ББ_ПрибавитьМалое(ББ_Ноль(), 97);
	Рез2 = ББ_МодульнаяСтепень(Осн10, Пок30, Мод97);
	Ожид2 = ББ_ПрибавитьМалое(ББ_Ноль(), 85);
	Если ББ_Сравнить(Рез2, Ожид2) = 0 Тогда
		Сообщить("Bignum деление по модулю: OK");
	Иначе
		Сообщить("Bignum деление по модулю: ОШИБКА");
	КонецЕсли;
КонецПроцедуры

// Медленный тест — реально подписывает JWT реальным ключом. Займёт минуты.
// PrivateKeyPEM — значение поля "private_key" из JSON-ключа сервисного аккаунта
// (весь текст, начиная с "-----BEGIN PRIVATE KEY-----").
Процедура СамотестJWT(Знач ClientEmail, Знач PrivateKeyPEM) Экспорт
	Сообщить("Начинаю подпись JWT — это медленно, минуты, подождите...");
	ВремяСтарта = ТекущаяДата();

	// Unix-время нужно строго в UTC, иначе Google сочтёт токен просроченным
	// (или ещё не наступившим) из-за разницы с часовым поясом сервера.
	// ТекущаяУниверсальнаяДата() — это отдельная функция 1С именно для UTC,
	// в отличие от ТекущаяДата() (локальное время сервера/сеанса).
	ВремяUnix = (ТекущаяУниверсальнаяДата() - Дата(1970, 1, 1));

	JWT = ПостроитьJWT(ClientEmail, PrivateKeyPEM, "https://www.googleapis.com/auth/spreadsheets", ВремяUnix);

	ВремяКонца = ТекущаяДата();
	Сообщить("Готово за " + (ВремяКонца - ВремяСтарта) + " сек.");
	Сообщить("JWT (первые 80 символов): " + Лев(JWT, 80) + "...");

	// Проверяем структуру без СтрРазделить (в имени функции не уверен) —
	// просто считаем точки-разделители вручную тем, что уже проверено выше.
	КоличествоТочек = 0;
	Для Индекс = 1 По СтрДлина(JWT) Цикл
		Если Сред(JWT, Индекс, 1) = "." Тогда
			КоличествоТочек = КоличествоТочек + 1;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоТочек = 2 Тогда
		Сообщить("Структура JWT верна: 2 точки-разделителя (3 части). OK");
